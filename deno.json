{
  "name": "@onamea/workers",
  "version": "0.3.4",
  "license": "MIT",
  "exports": "./mod.ts",
  "imports": {
    "@onamea/types": "jsr:@onamea/types@^0.3.4"
  },
  "tasks": {
    "compile": "deno compile --allow-env --output onamea --include ./src/worker.ts ./src/main.ts",
    "bundle": "deno bundle src/worker.ts --outdir dist",
    "run": "deno run --allow-read --allow-env src/main.ts"
  }
}
